# PostgreSQL db
DB_CONFIG__DB__SERVICE_NAME=postgres-db
DB_CONFIG__DB__USER=postgres
DB_CONFIG__DB__PASSWORD=postgres
DB_CONFIG__DB__NAME=db
DB_CONFIG__DB__HOST=postgres
DB_CONFIG__DB__PORT=5432
DB_CONFIG__DB__ECHO=false
DB_CONFIG__DB__ECHO_POOL=false
DB_CONFIG__DB__MAX_OVERFLOW=10
DB_CONFIG__DB__POOL_SIZE=5