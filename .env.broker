# RabbitMQ broker
BROKER_CONFIG__BROKER__SERVICE_NAME=
BROKER_CONFIG__BROKER__HOST=rabbitmq
BROKER_CONFIG__BROKER__PORT=5672
BROKER_CONFIG__BROKER__USER=guest
BROKER_CONFIG__BROKER__PASSWORD=guest
BROKER_CONFIG__BROKER__VHOST=/

BROKER_CONFIG__BROKER__PAYMENTS_EXCHANGE=payments
BROKER_CONFIG__BROKER__PAYMENTS_DLX_EXCHANGE=payments.dlx

BROKER_CONFIG__BROKER__PAYMENTS_QUEUE=payments.new
BROKER_CONFIG__BROKER__PAYMENTS_DEAD_QUEUE=payments.dead

BROKER_CONFIG__BROKER__PAYMENTS_QUEUE_ROUTING_KEY=payments.new
BROKER_CONFIG__BROKER__PAYMENTS_DEAD_QUEUE_ROUTING_KEY=payments.dead